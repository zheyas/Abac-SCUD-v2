DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Yekaterinburg

POSTGRES_DB=abac_scud
POSTGRES_USER=abac_scud
POSTGRES_PASSWORD=abac_scud
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# docker-compose overrides POSTGRES_HOST to "db" (PostgreSQL container)
# so the web container connects to the database container.

# Use only for local tests without PostgreSQL:
# SCUD_SQLITE=1
